# Required: create a copy named .env and paste your OpenAI API key here.
# Never commit the real key or share it in screenshots/logs.
OPENAI_API_KEY=

# Optional: OpenAI Images model. gpt-image-1 is used by default.
PICTOR_IMAGE_MODEL=gpt-image-1

# Optional: 1024x1024, 1024x1536, or 1536x1024, if supported by the model.
PICTOR_IMAGE_SIZE=1024x1024
